# gha-dind configuration. Copy to config.env and edit:
#
#   cp config.env.example config.env
#
# config.env is gitignored. Format is literal KEY=VALUE with no shell expansion,
# so the SAME file works as a systemd EnvironmentFile= (see
# systemd/gha-dind-pool.service). Environment variables override this file.

# --- required ---------------------------------------------------------------

# The repository whose Actions jobs these runners pick up, as <owner>/<repo>.
# There is no default: a runner pool with a guessed target is never what you
# want. A fine-grained PAT with repo Administration: read & write on THIS repo
# must be in secrets/gh-pat — it is used only to mint registration tokens.
REPO=owner/repo

# --- runner registration -----------------------------------------------------

# Labels the runners register with. Target them from a workflow via
#   runs-on: [self-hosted, dind]
RUNNER_LABELS=dind

# Number of concurrent runner slots pool.sh starts. Each slot is fully isolated
# (own inner dockerd + /var/lib/docker volume) and runs one job at a time, so
# size this to the width of the job matrix you want to run without queuing.
POOL_SIZE=4

# --- image build (build-image.sh / Dockerfile) -------------------------------

IMAGE=gha-dind-runner:latest

# Pinned actions/runner release. Bump to upgrade the runner agent, then rerun
# ./build-image.sh.
RUNNER_VERSION=2.335.1

# Toolchains baked into the runner tool-cache so actions/setup-go and
# actions/setup-node find them and skip their per-job download. Set either to
# an empty value to skip baking that toolchain — a job that needs it will then
# download it itself, as on a GitHub-hosted runner.
#
# Bake a version that SATISFIES what your workflow asks for — it need not be
# spelled identically. setup-* resolves its version spec as a semver range over
# what is installed, so a workflow asking go-version '1.25' hits a baked
# 1.25.12, and node-version '22' hits a baked 22.12.0.
GO_VERSION=1.25.12
NODE_VERSION=22.12.0

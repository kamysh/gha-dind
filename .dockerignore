# Keep the build context tiny — only the Dockerfile, container scripts, and
# dl/<runner-tarball> are needed. Ignore everything else so `docker build .`
# doesn't ship caches/secrets into the daemon.
*
!Dockerfile
!runner-entry.sh
!container-init.sh
!local-entry.sh
!scheduled-entry.sh
!scheduled-cleanup.sh
!scheduled-credential.sh
!scheduled.mjs
!scheduled-process.mjs
!dl/actions-runner-linux-x64-*.tar.gz
